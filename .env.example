POSTGRES_DB=wikimedia
POSTGRES_USER=wikimedia
POSTGRES_PASSWORD=wikimedia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host processes use localhost. The spark-analytics Compose service overrides
# these to the Docker network hostnames.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=wiki-edits
KAFKA_GROUP_ID=beam-fixed-windows
KAFKA_AUTO_OFFSET_RESET=latest
